+// RECOIL PATCH: per-call-site census of unsupported-function use.
+//
+// The first-use backtrace below names the head of the burn-down list; this names
+// EVERY reachable site with a call count, which is the actual work list. Static
+// grep cannot do it -- most legacy call sites in the engine are unreachable for
+// any given game, and only the reached ones block capture. Opt-in via
+// RDOC_SITE_CENSUS=1 because it backtraces on every offending call.
+namespace
+{
+struct RecoilSiteKey
+{
+  const char *name;
+  uintptr_t addr;
+  bool operator==(const RecoilSiteKey &o) const { return name == o.name && addr == o.addr; }
+};
+struct RecoilSiteHash
+{
+  size_t operator()(const RecoilSiteKey &k) const
+  {
+    return std::hash<const void *>()(k.name) * 1099511628211u ^ std::hash<uintptr_t>()(k.addr);
+  }
+};
+
+std::mutex recoilSiteLock;
+std::unordered_map<RecoilSiteKey, uint64_t, RecoilSiteHash> recoilSiteCounts;
+bool recoilSiteCensus = false, recoilSiteCensusChecked = false, recoilSiteDumpArmed = false;
+
+void RecoilDumpSiteCensus()
+{
+  std::lock_guard<std::mutex> lock(recoilSiteLock);
+  // sorted by call count so the expensive sites lead
+  std::vector<std::pair<RecoilSiteKey, uint64_t> > sorted(recoilSiteCounts.begin(),
+                                                          recoilSiteCounts.end());
+  std::sort(sorted.begin(), sorted.end(),
+            [](const std::pair<RecoilSiteKey, uint64_t> &a,
+               const std::pair<RecoilSiteKey, uint64_t> &b) { return a.second > b.second; });
+
+  fprintf(stderr, "[RDOC-SITE-CENSUS] %zu distinct call sites\n", sorted.size());
+  for(size_t i = 0; i < sorted.size(); i++)
+  {
+    Dl_info info;
+    if(dladdr((void *)sorted[i].first.addr, &info) && info.dli_fbase)
+      fprintf(stderr, "[RDOC-SITE] %10llu %s %s+0x%zx\n", (unsigned long long)sorted[i].second,
+              sorted[i].first.name, info.dli_fname ? info.dli_fname : "?",
+              (size_t)(sorted[i].first.addr - (uintptr_t)info.dli_fbase));
+  }
+  fflush(stderr);
+}
+
+// Returns the first return address outside librenderdoc itself -- i.e. the
+// application code that made the call, not the interception wrapper.
+uintptr_t RecoilCallerAddr()
+{
+  void *bt[8];
+  int n = backtrace(bt, 8);
+  Dl_info self;
+  if(!dladdr((void *)&RecoilCallerAddr, &self))
+    return 0;
+  for(int i = 0; i < n; i++)
+  {
+    Dl_info info;
+    if(dladdr(bt[i], &info) && info.dli_fbase != self.dli_fbase)
+      return (uintptr_t)bt[i];
+  }
+  return 0;
+}
+}    // anonymous namespace
+
 void WrappedOpenGL::UseUnusedSupportedFunction(const char *name)
 {
+  if(!recoilSiteCensusChecked)
+  {
+    recoilSiteCensusChecked = true;
+    const char *env = getenv("RDOC_SITE_CENSUS");
+    recoilSiteCensus = (env && env[0] && env[0] != '0');
+  }
+  if(recoilSiteCensus)
+  {
+    const uintptr_t caller = RecoilCallerAddr();
+    std::lock_guard<std::mutex> lock(recoilSiteLock);
+    recoilSiteCounts[{name, caller}]++;
+    if(!recoilSiteDumpArmed)
+    {
+      recoilSiteDumpArmed = true;
+      atexit(&RecoilDumpSiteCensus);
+    }
+  }
+
